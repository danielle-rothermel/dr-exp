# example environment configuration for dr_exp

# API key used by backend admin endpoints
ADMIN_API_KEY=secret

# Mode for Supabase client selection: files_local, supabase_local, supabase_remote
EXPMGR_MODE=files_local

# Supabase connection details for real mode
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_key
SUPABASE_KEY=anon_key

# Base path for mock database and storage
DR_EXP_BASE_PATH=./logs/

# Optional GPU visibility
CUDA_VISIBLE_DEVICES=0,1

# Optional SLURM job identifier
SLURM_JOB_ID=12345

# Debug mode for structured logger and other components
DEBUG=False
