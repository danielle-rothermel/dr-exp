# Example environment for dr_exp.
#
# dr-exp reads host configuration from a bundled machine profile inside the
# package (`dr_exp.config.machines`), not from the environment. Only the test
# suite consults an environment variable.

# Disposable PostgreSQL database for the integration tests. The suite refuses
# any name that does not end in "_test" because it recreates the schemas
# between tests.
DR_EXP_TEST_DATABASE_URL=postgresql+psycopg:///dr_exp_test
